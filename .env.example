# TRADING MODE: paper | manual | live
TRADING_MODE=paper

# Solana RPC
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
RUGCHECK_API_URL=https://api.rugcheck.xyz/v1

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_AUTHORIZED_USER_IDS=

# Database
DATABASE_URL=postgresql://user:pass@localhost:5432/meme_bot
REDIS_URL=redis://localhost:6379

# Risk gates
MAX_POSITION_SIZE_SOL=0.1
MAX_DAILY_LOSS_SOL=0.5
MAX_SLIPPAGE_BPS=200
MAX_PRICE_IMPACT_BPS=300
MAX_OPEN_POSITIONS=5
MIN_LIQUIDITY_USD=50000
RISK_PER_TRADE_SOL=0.01
MAX_TOP10_HOLDER_PERCENT=30
MAX_DEV_WALLET_PERCENT=5
MAX_QUOTE_AGE_MS=5000

# Exit monitor (automated stop-loss / take-profit / time stop)
EXIT_STOP_LOSS_PERCENT=30
EXIT_TAKE_PROFIT_PERCENT=50
# 0 disables the time stop
EXIT_MAX_HOLD_MS=7200000
EXIT_CHECK_INTERVAL_MS=30000

# Live trading only
# WALLET_PRIVATE_KEY=
# Rule 11 live execution (Jupiter routing). The provider runs the full
# QUOTE → VALIDATE → SIMULATE → SIGN → SUBMIT → CONFIRM → VERIFY pipeline and
# derives real fill amounts from on-chain balance deltas — never from the quote.
JUPITER_API_URL=https://quote-api.jup.ag/v6
LIVE_CONFIRM_TIMEOUT_MS=60000
LIVE_CONFIRM_POLL_MS=2000

# SECURITY_PROVIDER: rugcheck | mock
# mock is FORBIDDEN when TRADING_MODE=live. Use rugcheck in production.
SECURITY_PROVIDER=rugcheck

# ── Phase 2: multi-agent LLM debate (advisory layer) ───────────────────
# See docs/PHASE2_DESIGN.md. Default off = zero LLM calls, zero behavioral
# delta. shadow = record verdicts only; advise = may veto BUY signals.
# Rule 28: advisory only — can never approve or enlarge a trade.
DEBATE_MODE=off
# OpenAI-compatible chat completions endpoint (required for shadow/advise).
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Cost per 1k tokens (USD) — activates the daily-budget guard. Optional; the
# daily call cap still applies without them.
LLM_COST_PER_1K_INPUT_USD=0.00015
LLM_COST_PER_1K_OUTPUT_USD=0.0006
# Veto threshold (advise mode): judge confidence required to veto a BUY.
DEBATE_VETO_CONFIDENCE=0.8
# Budget / circuit-breaker defaults.
DEBATE_PER_CALL_TIMEOUT_MS=6000
DEBATE_WINDOW_MAX=8
DEBATE_WINDOW_MS=60000
DEBATE_DAILY_MAX=300
DEBATE_DAILY_BUDGET_USD=2.00
DEBATE_FAILURE_BREAKER_THRESHOLD=5
DEBATE_FAILURE_BREAKER_OPEN_MS=900000
# Dead-man switch: advise refuses to start in TRADING_MODE=live unless true.
DEBATE_ADVISE_LIVE=false

# Exclusive-claim lease for debate idempotency (audit fix #5): concurrent
# workers never double-spend on the same signal. Must exceed 3× the per-call
# timeout.
DEBATE_CLAIM_LEASE_MS=60000
