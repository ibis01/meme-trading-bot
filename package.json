    "bot:loop": "tsx src/app/runLoop.ts",
    "test:integration": "INTEGRATION=1 jest --config jest.integration.config.js --runInBand",
    "db:create:test": "tsx src/scripts/createTestDb.ts",
    "backtest:demo": "tsx src/scripts/backtestDemo.ts",
    "backtest": "tsx src/app/backtestCli.ts",
    "recorder": "tsx src/app/runRecorder.ts",
    "seed:demo-bars": "tsx src/scripts/seedDemoBars.ts",
    "walkforward": "tsx src/app/walkForwardCli.ts",
    "verdict:record": "tsx src/app/recordVerdictCli.ts",
    "strategy:compare": "tsx src/app/strategyCompareCli.ts",
    "strategy:robust": "tsx src/app/strategyRobustCli.ts",
    "data:status": "tsx src/app/dataStatusCli.ts",
    "backfill": "tsx src/app/backfillCli.ts",
    "evaluate:mints": "tsx src/app/multiMintCli.ts",
